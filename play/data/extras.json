  "crossovers": [
    {
      "id": "mila_juno",
      "a": "mila",
      "b": "juno",
      "need": 3,
      "title": "Fries vs Napkins",
      "teaser": "Mila and Juno have both been asking about you. Tonight they're asking each other.",
      "lines": [
        {
          "who": "narrator",
          "text": "Near closing time you find Mila and Juno at the bar, deep in an argument, with a basket of fries and a pile of napkins between them."
        },
        {
          "who": "mila",
          "e": "teasing",
          "text": "Okay, settle this. Juno says you're a bank-shot person. I say you're a straight-shot person."
        },
        {
          "who": "juno",
          "e": "neutral",
          "text": "I have diagrams."
        },
        {
          "who": "mila",
          "e": "angry",
          "text": "She has diagrams. She always has diagrams!"
        },
        {
          "who": "you",
          "text": "Why does it matter?"
        },
        {
          "who": "juno",
          "e": "teasing",
          "text": "Because whoever's right picks what you do on your next night off."
        },
        {
          "who": "mila",
          "e": "shy",
          "text": "We made a bet about you. It sounded better before you walked in."
        },
        {
          "who": "you",
          "text": "So I'm the puck."
        },
        {
          "who": "juno",
          "e": "happy",
          "text": "Finally, he gets it. One game each. Winner keeps you for the evening."
        },
        {
          "who": "narrator",
          "text": "It ends in a tie. They split the last of the fries and refuse to tell you who won."
        },
        {
          "who": "mila",
          "e": "teasing",
          "text": "Same time next week. Bring your own napkins."
        }
      ],
      "scene": {
        "id": "x_mila_juno",
        "title": "Fries and Napkins",
        "brief": "Mila and Juno sit on either side of you on the bar in league jerseys, one holding out a fry and the other a napkin diagram, glaring at each other over your head."
      }
    },
    {
      "id": "juno_kat",
      "a": "juno",
      "b": "kat",
      "need": 3,
      "title": "Two Bars, One Table",
      "teaser": "Juno levels the Afterglow's table every Monday. Kat swears hers is better. Somebody has to judge.",
      "lines": [
        {
          "who": "narrator",
          "text": "Monday at the Static. Juno has brought a spirit level, and Kat has brought a grudge."
        },
        {
          "who": "kat",
          "e": "angry",
          "text": "My table is not tilted. It has character."
        },
        {
          "who": "juno",
          "e": "teasing",
          "text": "It leans three degrees to the left. I measured it twice."
        },
        {
          "who": "kat",
          "e": "angry",
          "text": "You brought a level to my bar?"
        },
        {
          "who": "juno",
          "e": "neutral",
          "text": "I bring a level everywhere. It's called standards."
        },
        {
          "who": "you",
          "text": "Maybe you two should just play each other."
        },
        {
          "who": "kat",
          "e": "teasing",
          "text": "Fine. Loser buys the winner's drinks for a month."
        },
        {
          "who": "juno",
          "e": "teasing",
          "text": "And the loser admits the other one runs the better bar."
        },
        {
          "who": "narrator",
          "text": "Kat wins on her bumpers. Juno wins the rematch across the street. Nobody admits anything."
        },
        {
          "who": "juno",
          "e": "shy",
          "text": "Your table's fun. Don't tell anyone I said that."
        },
        {
          "who": "kat",
          "e": "happy",
          "text": "Your cocktails are criminal. Same time next Monday?"
        }
      ],
      "scene": {
        "id": "x_juno_kat",
        "title": "Sister Bars",
        "brief": "Juno and Kat sit back to back on the Static's bumper table sharing one cocktail with two straws while you hold the spirit level, both trying not to laugh."
      }
    },
    {
      "id": "kat_sable",
      "a": "kat",
      "b": "sable",
      "need": 2,
      "title": "Old Guard",
      "teaser": "Sable and Kat go back further than you knew.",
      "lines": [
        {
          "who": "narrator",
          "text": "You find Sable at the Static's bar. You've never once seen her set foot in there."
        },
        {
          "who": "sable",
          "e": "neutral",
          "text": "Kat's uncle taught me to play on that table in 1998. The bumpers were already there."
        },
        {
          "who": "kat",
          "e": "surprised",
          "text": "You knew Uncle Ray?"
        },
        {
          "who": "sable",
          "e": "happy",
          "text": "He beat me forty times in a row. Then he made me promise to beat everyone else."
        },
        {
          "who": "kat",
          "e": "shy",
          "text": "He used to say a girl from across the street would run this whole block one day."
        },
        {
          "who": "sable",
          "e": "sad",
          "text": "And then I sold it. He would be furious."
        },
        {
          "who": "you",
          "text": "So give him a reason to be proud."
        },
        {
          "who": "kat",
          "e": "teasing",
          "text": "One game, for Ray. Old rules."
        },
        {
          "who": "narrator",
          "text": "They play with the bumpers, the old way, and for once neither of them says a word of trash talk."
        },
        {
          "who": "sable",
          "e": "shy",
          "text": "You play like him. It is very irritating."
        }
      ],
      "scene": {
        "id": "x_kat_sable",
        "title": "For Ray",
        "brief": "Sable in her blazer and Kat in her band tee lean side by side on the Static's old table under a framed photo of Uncle Ray, toasting with two glasses, both pretending they aren't teary."
      }
    },
    {
      "id": "mila_sable",
      "a": "mila",
      "b": "sable",
      "need": 3,
      "title": "Speed Lesson",
      "teaser": "Mila wants a lesson from the undefeated. Sable wants to see if the courier can keep up.",
      "lines": [
        {
          "who": "narrator",
          "text": "Sable is holding court at the table when Mila skids in, still wearing her helmet."
        },
        {
          "who": "mila",
          "e": "teasing",
          "text": "Okay, Ms Undefeated. I want a lesson. A real one."
        },
        {
          "who": "sable",
          "e": "neutral",
          "text": "You are fast. Fast is not the same thing as good."
        },
        {
          "who": "mila",
          "e": "angry",
          "text": "Rude. Accurate, but rude."
        },
        {
          "who": "sable",
          "e": "teasing",
          "text": "Lesson one: stop hitting everything as hard as you can."
        },
        {
          "who": "mila",
          "e": "surprised",
          "text": "That's my whole personality!"
        },
        {
          "who": "you",
          "text": "She's not wrong, Mila."
        },
        {
          "who": "mila",
          "e": "angry",
          "text": "Whose side are you on?"
        },
        {
          "who": "sable",
          "e": "happy",
          "text": "Mine, obviously. Again. Slower this time."
        },
        {
          "who": "narrator",
          "text": "An hour later Mila bends a curve shot past Sable, and the two of them shriek like teenagers."
        },
        {
          "who": "sable",
          "e": "shy",
          "text": "She learns quickly. Like someone else I know."
        }
      ],
      "scene": {
        "id": "x_mila_sable",
        "title": "Speed Lesson",
        "brief": "Sable stands behind Mila at the table guiding her wrist on the paddle, Mila still in her helmet and grinning at you over her shoulder."
      }
    }
  ],
  "rival_barks": {
    "mila": {
      "juno": "Juno says you're good with angles. I'm better with speed.",
      "kat": "Kat says you can't drum. I heard it from the street.",
      "sable": "Sable taught you that curve, didn't she? Cheater."
    },
    "juno": {
      "mila": "Mila says your name a lot on her breaks. A lot.",
      "kat": "Kat thinks you play bass now. Let's see those hands.",
      "sable": "Sable's been watching you play. She never watches anyone."
    },
    "kat": {
      "mila": "Mila's courier crew keeps showing up at my bar asking for you.",
      "juno": "Juno told me you read her schedule out loud. Nerd.",
      "sable": "If Sable likes you, I have to beat you twice as hard."
    },
    "sable": {
      "mila": "The courier talks about you constantly. It is exhausting.",
      "juno": "Juno vouched for you. Juno does not vouch for people.",
      "kat": "Kat Vance's uncle would have liked you. Do not let it go to your head."
    }
  },
  "finale_by_first": {
    "mila": [
      {
        "who": "mila",
        "e": "teasing",
        "text": "For the record, I was first. First to hate you, first to like you. Put that on the wall."
      },
      {
        "who": "juno",
        "e": "teasing",
        "text": "She was also first to throw a fry at him. Put that on the wall too."
      }
    ],
    "juno": [
      {
        "who": "juno",
        "e": "teasing",
        "text": "For the record, I called it. Napkin forty-three: he wins the whole thing. It's laminated."
      },
      {
        "who": "mila",
        "e": "angry",
        "text": "You laminate your napkins?"
      }
    ],
    "kat": [
      {
        "who": "kat",
        "e": "happy",
        "text": "For the record, the Static backed you first. We're printing your face on T-shirts. Not crossed out this time."
      },
      {
        "who": "sable",
        "e": "teasing",
        "text": "I will take a medium."
      }
    ],
    "sable": [
      {
        "who": "sable",
        "e": "teasing",
        "text": "For the record, I saw this coming first. I simply chose not to say so."
      },
      {
        "who": "kat",
        "e": "teasing",
        "text": "She absolutely did not."
      }
    ]
  },
